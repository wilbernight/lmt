APP_NAME="WilberNight"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Use a dedicated database user with privileges on this database only (never root).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daftar
DB_USERNAME=daftar
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Comma-separated IPs of your reverse proxy / load balancer, if any.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@daftar.test"
MAIL_FROM_NAME="${APP_NAME}"

# Generate with: php artisan reverb:install  (or any long random strings)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Password for the local demo accounts created by `php artisan db:seed` (local only).
DEMO_PASSWORD="Daftar-Demo-2026!"

# Require two-factor login for site administrators (defaults to true in production).
ADMIN_REQUIRES_2FA=false

# Hosts allowed to open realtime sockets (defaults to the APP_URL host and localhost).
REVERB_ALLOWED_ORIGINS=

# Encryption at rest for business data (AES-256-GCM), separate from APP_KEY. BACK IT UP.
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=
